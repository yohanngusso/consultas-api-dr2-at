# Copie para .env e preencha com valores do seu ambiente. O .env real nunca é versionado nem entregue.

# Persistência. Em produção a URL vem do cofre de segredos, ex.:
# CLINICA_DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@host:5432/clinica
CLINICA_DATABASE_URL=sqlite:///./clinica.db
CLINICA_ECHO_SQL=false

# Obrigatória, sem valor padrão, mínimo de 32 caracteres. Gere com:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
CLINICA_JWT_SECRET=

# Allowlist explícita de origens, separadas por vírgula. Wildcard é recusado na inicialização.
CLINICA_CORS_ORIGENS=http://localhost:5173,https://app.clinicas.exemplo.dev

# Cookie da sessão da recepção com atributo Secure. Use false apenas em desenvolvimento sem HTTPS.
CLINICA_COOKIE_SEGURO=true

# Documentação interativa (/docs, /redoc, /openapi.json). Desligar em produção.
CLINICA_DOCS_ATIVOS=true

CLINICA_RATE_LIMIT_ATIVO=true
CLINICA_RATE_LIMIT_PADRAO=120/minute
CLINICA_RATE_LIMIT_LOGIN=5/minute
CLINICA_RATE_LIMIT_ESCRITA=20/minute
CLINICA_RATE_LIMIT_LEITURA=60/minute

CLINICA_BLOQUEIO_TENTATIVAS=5
CLINICA_BLOQUEIO_MINUTOS=15

# Carrega contas e consultas de avaliação (senhas no README). Somente avaliação: false em produção.
CLINICA_CARREGAR_DADOS_DEMONSTRACAO=true

# Liga o router /inseguro com as versões vulneráveis do Exercício 8. Manter false.
CLINICA_MODO_DEMONSTRACAO_INSEGURA=false
