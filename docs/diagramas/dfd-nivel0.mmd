        PAC["Paciente<br/>(frontend)"]
        PRO["Profissional de saúde<br/>(frontend)"]
        ADM["Administrador<br/>(frontend + MFA)"]
    end
    subgraph TB2["Fronteira 2: Rede interna da clínica"]
        REC["Recepção<br/>(navegador)"]
    end
    subgraph TB3["Fronteira 3: Parceiro externo"]
        LAB["Laboratório parceiro<br/>(sistema M2M)"]
    end
    subgraph TB4["Fronteira 4: Aplicação"]
        API(("consultas-api"))
    end
    subgraph TB5["Fronteira 5: Dados"]
        DB[("Banco relacional<br/>pacientes, consultas,<br/>usuários, auditoria")]
    end
    PAC -- "credenciais / JWT<br/>[dado de saúde do titular]" --> API
    PRO -- "JWT + consultas<br/>[dado de saúde]" --> API
