    REC -- "cookie de sessão + CSRF<br/>[agenda sem motivo clínico]" --> API
    LAB -- "client_credentials<br/>[somente horários]" --> API
    API -- "SQL parametrizado<br/>[PII + saúde]" --> DB
    API -- "JSON / HTML" --> PAC
    API -- "JSON" --> PRO
    API -- "HTML com autoescape" --> REC
    API -- "horários livres, sem PII" --> LAB
